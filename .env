# NOTE: Local dev defaults, intentionally committed. Not a production project.
PORT       = 3000

__DOCKER_VOLUMES_DIR__ = ~/.local/share/my_docker_data/url_shortener/

POSTGRES_PORT        = 2345
POSTGRES_USER        = postgres
POSTGRES_PASSWORD    = postgres
POSTGRES_NAME        = url_shortener
POSTGRES_URL         = postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_NAME}?sslmode=disable
POSTGRES_VOLUME_PATH = ${__DOCKER_VOLUMES_DIR__}/postgres/

REDIS_PORT         = 9736
REDIS_ADDRESS      = localhost:${REDIS_PORT}
REDIS_VOLUME_PATH  = ${__DOCKER_VOLUMES_DIR__}/redis/
